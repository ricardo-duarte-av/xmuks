    <string name="pref_send_read_receipts">Send read receipts</string>
    <string name="pref_send_read_receipts_desc">Should read receipts be sent to other users? If off, they use the private type, which only syncs to your own devices.</string>
    <string name="pref_send_typing_notifications">Send typing notifications</string>
    <string name="pref_send_typing_notifications_desc">Should typing notifications be sent to other users?</string>

    <string name="pref_send_bundled_url_previews_desc">Should the composer offer fetching URL previews to bundle in outgoing messages?</string>
    <string name="pref_display_read_receipts">Display read receipts</string>
    <string name="pref_display_read_receipts_desc">Should read receipts be shown in the timeline?</string>
    <string name="pref_show_media_previews">Show image and video previews</string>
    <string name="pref_show_media_previews_desc">If off, images and videos only appear (and download) once tapped. This also hides images in URL previews.</string>
    <string name="pref_autoplay_gifs">Autoplay video GIFs</string>
    <string name="pref_autoplay_gifs_desc">Whether GIF-like videos (animated stickers) should play in a loop on their own.</string>
    <string name="pref_show_inline_images">Show inline images</string>
    <string name="pref_show_inline_images_desc">If off, custom emoji and other inline images aren\'t drawn: their text is shown instead.</string>
    <string name="pref_show_invite_avatars">Show avatars in invites</string>
    <string name="pref_show_invite_avatars_desc">If off, the avatar of the room or inviter isn\'t shown for invites.</string>
    <string name="pref_code_block_line_wrap">Code block line wrap</string>
    <string name="pref_code_block_line_wrap_desc">Whether long lines in code blocks wrap instead of scrolling sideways.</string>
    <string name="pref_code_block_theme">Code block theme</string>
    <string name="pref_code_block_theme_desc">The syntax highlighting theme for code blocks.</string>
    <string name="pref_show_hidden_events">Show hidden events</string>
    <string name="pref_show_hidden_events_desc">Whether hidden events should be visible in the room timeline.</string>
    <string name="pref_show_redacted_events">Show deleted message placeholders</string>
    <string name="pref_show_redacted_events_desc">Whether deleted messages should leave a placeholder behind in the timeline.</string>
    <string name="pref_show_membership_events">Show membership events</string>
    <string name="pref_show_membership_events_desc">Whether joins, leaves, invites and the like should be visible in the timeline.</string>
    <string name="pref_show_profile_changes">Show profile changes</string>
    <string name="pref_show_profile_changes_desc">Whether name and avatar changes should be visible in the timeline.</string>
    <string name="pref_render_url_previews">Show URL previews</string>
    <string name="pref_render_url_previews_desc">Whether to show URL previews bundled in messages (MSC4095).</string>
    <string name="pref_small_replies">Compact reply style</string>
    <string name="pref_small_replies_desc">Whether replies should use a compact, Discord-like style instead of the traditional one.</string>
    <string name="pref_small_threads">Compact thread messages</string>
    <string name="pref_small_threads_desc">Whether thread messages should only take a single line in the main timeline.</string>
    <string name="pref_show_date_separators">Show date separators</string>
    <string name="pref_show_date_separators_desc">Whether messages on different days should have a date between them.</string>
    <string name="pref_show_room_emoji_packs">Show room emoji packs</string>
    <string name="pref_show_room_emoji_packs_desc">Whether to show custom emoji packs provided by the room. If off, only your personal packs are offered.</string>
    <string name="pref_upload_dialog">Show upload dialog</string>
    <string name="pref_upload_dialog_desc">Whether to show the screen for adjusting media (resizing, caption) before it\'s sent.</string>
    <string name="pref_hide_fingerprint">Hide fingerprint</string>
    <string name="pref_hide_fingerprint_desc">Avoid sending data that\'s easily fingerprintable: no URL previews in messages, and no commands for bots.</string>
    <string name="pref_gif_provider">GIF provider</string>
    <string name="pref_gif_provider_desc">The service to search for GIFs with.</string>
    <string name="pref_max_image_width">Max image width</string>
    <string name="pref_max_image_width_desc">The widest images get in the timeline (gomuks web pixels; 320 by default).</string>
    <string name="pref_room_list_preview">Previews in room list</string>
    <string name="pref_room_list_preview_desc">Should the room list show a preview of the last message?</string>
    <string name="pref_room_list_style">Room list style</string>
    <string name="pref_room_list_style_desc">How much space room list entries take.</string>
    <string name="pref_pin_favorites">Pin favourites to top</string>
    <string name="pref_pin_favorites_desc">Always keep favourite rooms at the top of the room list, whatever the recent activity.</string>
    <string name="pref_pin_low_priority">Pin low priority to bottom</string>
    <string name="pref_pin_low_priority_desc">Always keep low priority rooms at the bottom of the room list, whatever the recent activity.</string>
    <string name="pref_mute_low_priority">No unreads in low priority</string>
    <string name="pref_mute_low_priority_desc">Don\'t count unread messages in low priority rooms. Notifications and mentions still count.</string>
    <string name="pref_alphabetical_order">Alphabetical room list</string>
    <string name="pref_alphabetical_order_desc">Sort rooms by name instead of recent activity.</string>
    <string name="pref_room_view_type">Room type override</string>
    <string name="pref_room_view_type_desc">Show this room as a specific kind instead of what it says it is.</string>
    <string name="pref_low_bandwidth">Low bandwidth mode</string>
    <string name="pref_low_bandwidth_desc">Save data where possible.</string>


<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Calls: microphone (RECORD_AUDIO comes with voice messages), camera, audio routing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Telecom (self-managed calls): headsets, cars, Wear and the system's audio routing. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- A call keeps the microphone and camera while the app isn't visible (CallService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- A ringing call takes over the lock screen (Android 14+: calling apps only). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The screen goes dark at your ear in a voice call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application>
        <service
            android:name=".system.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <receiver
            android:name=".system.DeclineReceiver"
            android:exported="false" />
    </application>
</manifest>
